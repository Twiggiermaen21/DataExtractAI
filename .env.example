# === DATAEXTRACTAI SERVICE CONFIGURATION ===
PORT=5000
LOG_LEVEL=INFO

# Połączenie z modelem LLM
LLM_API_URL=http://localhost:8080/v1/chat/completions
LLM_MODEL=default
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=600

# Weryfikacja tokenów JWT z Django
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
VERIFY_USER_IN_DB=false

# Limity i kolejkowanie
IUSFULLY_TEMPLATE_MAX_CONCURRENT_REQUESTS=2
IUSFULLY_TEMPLATE_MAX_FILE_BYTES=20971520
