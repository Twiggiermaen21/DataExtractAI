FLASK_ENV=production
LOG_LEVEL=INFO

# OpenAI-compatible chat-completions endpoint, for example llama-server:
# http://host.docker.internal:8080/v1/chat/completions on Docker Desktop
# http://127.0.0.1:8080/v1/chat/completions when running without Docker
# http://llm:8080/v1/chat/completions when LLM is another compose service
LLM_API_URL=http://host.docker.internal:8080/v1/chat/completions
LLM_MODEL=default
LLM_MAX_TOKENS=8000

PORT=5000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600